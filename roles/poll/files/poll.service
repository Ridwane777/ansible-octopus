[Unit]
Description=Poll voting application
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/poll
ExecStart=/usr/bin/gunicorn app:app -b 0.0.0.0:80 --log-file=- --access-logfile=- --workers 4 --keep-alive 0
Restart=always
RestartSec=10
Environment=REDIS_HOST={{ hostvars['redis-1']['ansible_host'] }}
Environment=REDIS_PORT=6379

[Install]
WantedBy=multi-user.target