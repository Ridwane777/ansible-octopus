
[Unit]
Description=Java Worker Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/worker
ExecStart=/usr/bin/java -jar /opt/worker/target/worker-jar-with-dependencies.jar
Restart=always
RestartSec=10
Environment=REDIS_HOST={{ hostvars['redis-1']['ansible_host'] }}
Environment=POSTGRES_HOST={{ hostvars['postgresql-1']['ansible_host'] }}
Environment=POSTGRES_PORT=5432
Environment=POSTGRES_USER={{ postgres_user }}
Environment=POSTGRES_PASSWORD={{ postgres_password }}
Environment=POSTGRES_DB={{ postgres_db }}

[Install]
WantedBy=multi-user.target